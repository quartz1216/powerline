<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Only the search settings; launch history and favorites stay on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="powerline_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="powerline_settings.xml" />
    </device-transfer>
</data-extraction-rules>
